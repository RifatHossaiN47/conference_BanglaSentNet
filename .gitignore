# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
*.egg-info/
dist/
build/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Editor & OS artifacts
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Microsoft Office temporary lock files (e.g., ~$presentation.pptx)
~$*

# Sensitive Publisher Legal Contracts (Private Signed Agreements)
*License_To_Publish*
*LTP*
*confidential*
*Confidential*

# Model checkpoints & heavy weights (>100MB)
*.bin
*.pt
*.pth
*.ckpt
*.h5
